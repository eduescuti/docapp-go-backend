# Copiar a .env (que no se commitea) y completar.
PORT=3000
DATABASE_URL="file:./dev.db"
# Días sin usar la app hasta que vence la sesión (05-sesiones-y-tokens.md).
DIAS_SESION_INACTIVA=90
# Origen de la app en web (Expo). En el celular no hay CORS.
ORIGEN_PERMITIDO=http://localhost:8081
# Clave del HMAC del número de trámite del DNI (verificación de identidad del registro). Solo vive en el
# servidor: generala con `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SECRETO_IDENTIDAD=
